<%!
from bauble.plugins.report import get_plants_pertinent_to, options
from bauble.utils import date_string
import json

features = []
%>\
% for plt in get_plants_pertinent_to(values, as_task=True):
<%
  if plt.geojson:
    features.append(
      {
        "type": "Feature",
        "id": plt.id,
        "geometry": plt.geojson,
        "properties": {
          "plt_id": plt.id,
          "plant": str(plt),
          "taxon": plt.accession.qualified_name,
          "family": plt.accession.species.family_name,
          "quantity": plt.quantity,
          "bed": plt.location.code,
          "planted": date_string(plt.planted.date),
          "died": date_string(plt.death.date) if plt.death else None,
        }
      }
    )
%>\
% endfor
${
json.dumps(
  {"type": "FeatureCollection", "features": features},
  indent=options.get("indent") or None
)
}
