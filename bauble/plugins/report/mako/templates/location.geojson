<%!
from bauble.plugins.report import get_locations_pertinent_to, options
import json

features = []
%>\
% for loc in get_locations_pertinent_to(values, as_task=True):
<%
  if loc.geojson:
    features.append(
      {
        "type": "Feature",
        "id": loc.id,
        "geometry": loc.geojson,
        "properties": {
          "loc_id": loc.id,
          "code": loc.code,
          "name": loc.name,
          "description": loc.description,
        }
      }
    )
%>\
% endfor
${
json.dumps(
  {"type": "FeatureCollection", "features": features},
  indent=options.get("indent") or None
)
}
