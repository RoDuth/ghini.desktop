<%!
from bauble.plugins.report import get_locations_pertinent_to, options
from bauble.utils.geo import get_approx_area_from_geojson_sqm
import json

from shapely import concave_hull
from shapely.geometry import mapping, shape
from shapely.ops import unary_union

polygons = []
%>\
<%
  polygons = [shape(loc.geojson) for loc in get_locations_pertinent_to(values, as_task=True) if loc.geojson]
  combined = unary_union(polygons)
  rubber_band = concave_hull(combined, ratio=options.get("ratio", 0.3))
  geometry = mapping(rubber_band)
  area = get_approx_area_from_geojson_sqm(geometry)
%>\
${
json.dumps(
{
  "type": "FeatureCollection",
  "features": [
    {
      "type": "Feature",
      "geometry": mapping(rubber_band),
      "properties": {"description": "Rubber Band Boundry", "area": f"{area:.2f} sq. m."}
    }
  ]
},
indent=options.get("indent")
)
}
